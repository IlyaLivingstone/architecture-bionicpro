# Секрет сервисной учётной записи Keycloak для сервиса аутентификации
KEYCLOAK_AUTH_CLIENT_SECRET=auth-service-secret-change-me

# Ключ AES-256 (base64) для шифрования токенов в Redis
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
