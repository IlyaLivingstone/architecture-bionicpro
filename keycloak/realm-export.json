{
  "id": "reports-realm",
  "realm": "reports-realm",
  "enabled": true,
  "displayName": "BionicPRO",
  "accessTokenLifespan": 120,
  "accessTokenLifespanForImplicitFlow": 120,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpSupportedApplications": [
    "FreeOTP",
    "Google Authenticator"
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user role"
      },
      {
        "name": "administrator",
        "description": "Administrator role"
      },
      {
        "name": "prothetic_user",
        "description": "Prothetic user role with report access"
      }
    ]
  },
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@example.com",
      "firstName": "User",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "user2",
      "enabled": true,
      "email": "user2@example.com",
      "firstName": "User",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["administrator"],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "prothetic1",
      "enabled": true,
      "email": "prothetic1@example.com",
      "firstName": "Prothetic",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "prothetic2",
      "enabled": true,
      "email": "prothetic2@example.com",
      "firstName": "Prothetic",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"],
      "requiredActions": ["CONFIGURE_TOTP"]
    },
    {
      "username": "prothetic3",
      "enabled": true,
      "email": "prothetic3@example.com",
      "firstName": "Prothetic",
      "lastName": "Three",
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"],
      "requiredActions": ["CONFIGURE_TOTP"]
    }
  ],
  "clients": [
    {
      "clientId": "reports-frontend",
      "name": "BionicPRO web client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    },
    {
      "clientId": "reports-api",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "oNwoLQdvJAvRcL89SydqCWCe5ry1jMgq",
      "bearerOnly": true
    },
    {
      "clientId": "bionicpro-auth",
      "name": "BionicPRO auth service (service account)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "auth-service-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Яндекс ID",
      "providerId": "oidc",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": true,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "bionicpro-yandex-client-id",
        "clientSecret": "bionicpro-yandex-client-secret",
        "authorizationUrl": "https://oauth.yandex.ru/authorize",
        "tokenUrl": "https://oauth.yandex.ru/token",
        "userInfoUrl": "https://login.yandex.ru/info?format=json",
        "logoutUrl": "",
        "issuer": "",
        "defaultScope": "login:email login:info",
        "validateSignature": "false",
        "useJwksUrl": "false",
        "syncMode": "IMPORT",
        "pkceEnabled": "true",
        "pkceMethod": "S256"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "yandex-id",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "id",
        "user.attribute": "yandexId"
      }
    },
    {
      "name": "yandex-login",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "login",
        "user.attribute": "yandexLogin"
      }
    },
    {
      "name": "yandex-phone",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "default_phone",
        "user.attribute": "phone"
      }
    },
    {
      "name": "yandex-first-name",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "first_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "yandex-last-name",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "last_name",
        "user.attribute": "lastName"
      }
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  }
}
